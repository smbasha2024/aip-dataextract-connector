{
  "name": "aip-dataextract-connector-desktop",
  "productName": "AIProxys Connector",
  "version": "0.1.0",
  "type": "module",
  "description": "AIProxys Connector Desktop",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "copy:frontend": "rimraf resources/frontend && cpx \"../frontend/dist/**/*\" resources/frontend",
    "build": "npm run clean && npm run build:main && npm run build:preload",
    "electron": "npm run build && electron .",
    "dist": "npm run build && npm run copy:frontend && electron-builder"
  },
  "author": "Basha",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "cpx": "^1.5.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.aiproxys.connector",
    "productName": "AIProxys Connector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
